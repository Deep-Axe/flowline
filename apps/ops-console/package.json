{
  "name": "@flowline/ops-console",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "ng": "ng",
    "dev": "ng serve --port 5173 --proxy-config proxy.conf.json",
    "start": "ng serve --port 5173 --proxy-config proxy.conf.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false",
    "lint": "eslint src --max-warnings=0",
    "typecheck": "ng build --configuration development",
    "update": "ng update @angular/core @angular/cli --allow-dirty --force",
    "codegen": "graphql-codegen --config codegen.ts",
    "check:generated": "node ./scripts/check-generated.mjs"
  },
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4",
    "@angular/platform-browser": "^22.1.4",
    "@apollo/client": "^4.2.3",
    "apollo-angular": "^14.2.0",
    "graphql": "^16.11.0",
    "graphql-ws": "^6.0.6",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.1.6",
    "@angular/cli": "^22.1.6",
    "@angular/compiler-cli": "^22.1.4",
    "angular-eslint": "^22.1.0",
    "@graphql-codegen/cli": "^5.0.7",
    "@graphql-codegen/typed-document-node": "^5.1.2",
    "@graphql-codegen/typescript": "^4.1.6",
    "@graphql-codegen/typescript-operations": "^4.6.1",
    "eslint": "^9.39.1",
    "@eslint/js": "^9.39.1",
    "jsdom": "^28.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.46.0",
    "vitest": "^4.0.8"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
