{
  "name": "flowline",
  "private": true,
  "workspaces": [
    "apps/ops-console",
    "packages/contracts"
  ],
  "dependencies": {
    "@angular/common": "^22.1.4",
    "@angular/compiler": "^22.1.4",
    "@angular/core": "^22.1.4"
  },
  "scripts": {
    "dev:console": "npm --prefix apps/ops-console run dev",
    "build:console": "npm --prefix apps/ops-console run build",
    "test:console": "npm --prefix apps/ops-console run test",
    "update:console": "npm --prefix apps/ops-console run update",
    "contracts:generate": "npm --workspace packages/contracts run generate",
    "contracts:check": "npm --workspace packages/contracts run check:stale",
    "codegen": "npm --workspace apps/ops-console run codegen",
    "check": "powershell -File scripts/flowline.ps1 check",
    "setup": "powershell -File scripts/flowline.ps1 setup"
  },
  "engines": {
    "node": "^22.22.3 || ^24.15.0 || >=26.0.0"
  }
}
