            },
            "type": "array",
            "title": "Frames"
          }
        },
        "type": "object",
        "required": [
          "duration_sec",
          "frames"
        ],
        "title": "DemoTimeline"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
