{
  "openapi": "3.1.0",
  "info": {
    "title": "FLOWLINE Crowd API",
    "description": "Crowd density, bottleneck detection, and rerouting for venue operations. Inference via Hugging Face rootstrap-org/crowd-counting (CSRNet).",
    "version": "1.0.0"
  },
  "paths": {
    "/api/venue": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Get Venue",
        "operationId": "get_venue",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Venue"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/timeline": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Get Timeline",
        "operationId": "get_timeline",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DemoTimeline"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/tick": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Get Demo Tick",
        "operationId": "get_demo_tick",
        "parameters": [
          {
            "name": "t",
            "in": "query",
            "required": false,
            "schema": {
              "type": "number",
              "maximum": 120,
              "minimum": 0,
              "default": 0,
              "title": "T"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/demo/reset": {
      "post": {
        "tags": [
          "ops"
        ],
        "summary": "Demo Reset",
        "operationId": "demo_reset",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OkResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/model/status": {
      "get": {
        "tags": [
          "ops"
        ],
        "summary": "Model Status",
        "operationId": "model_status",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ModelStatus"
                }
              }
            }
          }
        }
      }
    },
    "/api/analyze": {
      "post": {
        "tags": [
          "ops"
        ],
        "summary": "Analyze",
        "operationId": "analyze",
        "requestBody": {
          "content": {
            "multipart/form-data": {
              "schema": {
                "$ref": "#/components/schemas/Body_ops-analyze"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Snapshot"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "system"
        ],
        "summary": "Health",
        "operationId": "health",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    }
