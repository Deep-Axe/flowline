        "properties": {
          "file": {
            "type": "string",
            "format": "binary",
            "title": "File"
          },
          "phase": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Phase"
          },
          "reset": {
            "type": "boolean",
            "title": "Reset",
            "default": false
          }
        },
        "type": "object",
        "required": [
          "file"
        ],
        "title": "Body_ops-analyze"
      },
      "DemoTimeline": {
        "properties": {
          "duration_sec": {
